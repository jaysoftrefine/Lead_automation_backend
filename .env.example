# Online Cloud Database (Supabase / PostgreSQL)
# Get from Supabase Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-service-role-key

# Fallback: SQLite Central Database Configuration (used if DATABASE_URL is empty)
SQLITE_DB_PATH=data/leads.db

# LLM Configuration
# Options: "gemini" or "nvidia"
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API Key & Model
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA API Key & Model
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Tavily Web Search API Key
TAVILY_API_KEY=your_tavily_api_key_here

# Pipeline Settings
MAX_SEARCH_RESULTS_PER_LEAD=5
SCRAPE_RESULTS_LIMIT=20
LOG_LEVEL=INFO
