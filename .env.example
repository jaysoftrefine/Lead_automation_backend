# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=lead_gen_db
MONGODB_COLLECTION_NAME=enriched_leads
MONGODB_RAW_COLLECTION_NAME=raw_jobs

# LLM Configuration
# Options: "gemini" or "nvidia"
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API Key & Model
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA API Key & Model
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Tavily Web Search API Key
TAVILY_API_KEY=your_tavily_api_key_here

# Pipeline Settings
MAX_SEARCH_RESULTS_PER_LEAD=5
SCRAPE_RESULTS_LIMIT=20
LOG_LEVEL=INFO
